!SHIFT_ATCP_revised/results/brfss_to_nhanes_surveyweighted/*.json
!SHIFT_ATCP_revised/results/controlled_shift/
!SHIFT_ATCP_revised/results/controlled_shift/*.csv
!SHIFT_ATCP_revised/results/brfss_nhanes/
!SHIFT_ATCP_revised/results/brfss_nhanes/*.csv

# But STILL exclude the huge ones
