# ---- override: keep v2 LaTeX sources ----
!SHIFT_ATCP_revised/methodology.tex
!SHIFT_ATCP_revised/references.bib

# ---- Allow result CSVs in the repo (results are deliverables) ----
!SHIFT_ATCP_revised/results/
!SHIFT_ATCP_revised/results/brfss_to_nhanes/
!SHIFT_ATCP_revised/results/brfss_to_nhanes/*.csv
!SHIFT_ATCP_revised/results/brfss_to_nhanes/*.json
!SHIFT_ATCP_revised/results/brfss_to_nhanes_surveyweighted/
