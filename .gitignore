.venv/
__pycache__/
*.py[cod]
.DS_Store
.vscode/
.cache/
*.tmp
*.out
*.err

# Generated experiment outputs and local artifacts
outputs*/
overleaf*/
*.joblib
*.zip
*.docx
*.html

# LaTeX source and build artifacts
*.tex
*.bib
*.bbl
*.blg
*.aux
*.log
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# ---- v2 SHIFT_ATCP_revised: only these are excluded ----
# (inner SHIFT_ATCP_revised/.gitignore handles data/ and models/)
SHIFT_ATCP_revised/__pycache__/
SHIFT_ATCP_revised/**/__pycache__/
SHIFT_ATCP_revised/.pytest_cache/
SHIFT_ATCP_revised/*.log

# Keep v2 LaTeX sources despite the *.tex / *.bib rules above
!SHIFT_ATCP_revised/methodology.tex
!SHIFT_ATCP_revised/references.bib

# Backups
.git.backup/
.git.backup2/
.gitignore.before-results-fix
